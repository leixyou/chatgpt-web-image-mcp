# Use exactly one browser mode. A dedicated persistent profile is the default.
CHATGPT_CHROME_USER_DATA_DIR=~/.chatgpt-web-image-mcp/chrome-profile
# CDP attaches to an already-running, debug-enabled Chrome and takes precedence.
# Chrome 136+ does not expose CDP for the default Chrome data directory.
# CHATGPT_CDP_URL=http://127.0.0.1:9222

# chat = regular conversation/project composer; images = https://chatgpt.com/images/
CHATGPT_WEB_SURFACE=chat
# Optional URL override. Leave unset to use the selected surface's default URL.
# CHATGPT_WEB_URL=https://chatgpt.com/
# setup-project writes these values to the local settings file automatically.
# Environment values override that file when set.
# CHATGPT_PROJECT_URL=https://chatgpt.com/g/g-p-YOUR_PROJECT/project
# CHATGPT_PROJECT_NAME=ChatGPT Web Image MCP
# CHATGPT_CHARACTER_PROFILE=same adult character, facial structure, hair, body proportions, wardrobe anchors
# CHATGPT_STYLE_PROFILE=cinematic editorial photography, restrained palette, soft directional light
# CHATGPT_SETTINGS_FILE=~/.chatgpt-web-image-mcp/settings.json
CHATGPT_IMAGE_OUTPUT_DIR=~/.chatgpt-web-image-mcp/outputs
CHATGPT_IMAGE_TIMEOUT_MS=600000
CHATGPT_IMAGE_MAX_COUNT=4
CHATGPT_IMAGE_MAX_BYTES=20971520

# Required only when the AI may upload local source images for image editing.
# Separate multiple roots with the platform path delimiter (`:` on macOS/Linux).
# CHATGPT_IMAGE_ALLOWED_INPUT_DIRS=/absolute/path/to/assets:/another/safe/path

# Keep false unless the CDP endpoint is on a trusted private host.
CHATGPT_ALLOW_REMOTE_CDP=false
CHATGPT_HEADLESS=false
CHATGPT_CHROME_CHANNEL=chrome
